# Line endings: Git picks the right one per OS
* text=auto

# Unity text files: always LF
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf
*.scenetemplate text eol=lf

# Binary files: never change them
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.ttf binary
*.otf binary
*.zip binary
